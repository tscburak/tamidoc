# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/tamidoc

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api
TAMIDOC_EDITION=community

# Frontend URL (for CORS & OAuth callbacks)
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Service (for password reset & verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@tamidoc.com

# Object Storage (RustFS / S3-compatible)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_PUBLIC_BASE_URL=

# PDF Import: Jev input detection (server-side credentials only)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Conservative acceptance threshold; tune against representative documents.
PDF_IMPORT_FIELD_CONFIDENCE=0.75
# Optional pricing overrides in USD per million tokens. Empty uses the pinned
# jev-1.13.0 rate: input 0.042, output 0. Other model versions need explicit rates.
TYPESAFE_INPUT_USD_PER_MILLION=
TYPESAFE_OUTPUT_USD_PER_MILLION=
PDF_IMPORT_MAX_PAGES=20
PDF_IMPORT_RENDER_SCALE=2
PDF_IMPORT_MAX_FILE_MB=10
