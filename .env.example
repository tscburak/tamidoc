# ============================================================
# Tamidoc Docker Compose environment
# Copy to .env and fill in real values:  cp .env.example .env
# ============================================================

# --- Public entry point (the proxy) ---
# Port the proxy publishes on the host.
PUBLIC_PORT=8080
# Canonical URL the browser uses to reach the app (no trailing slash).
# Feeds the API's FRONTEND_URL (CORS allow-list + OAuth redirects).
# Set to your real domain in production, e.g. https://tamidoc.example.com
APP_URL=http://localhost:8080

# --- App ---
NODE_ENV=production
API_PREFIX=api
TAMIDOC_EDITION=community
# Docker Compose serves the API on port 3000 inside its network.

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# --- Bundled RustFS object storage ---
# Compose starts RustFS and creates this bucket automatically. Keep these
# credentials unique; they are shared by RustFS and the API.
# Set S3_ENDPOINT only when connecting the API to an external S3 service.
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=tamidoc
S3_ACCESS_KEY_ID=tamidoc-local
S3_SECRET_ACCESS_KEY=change-me-to-a-unique-rustfs-secret
S3_FORCE_PATH_STYLE=true
# Stored object URLs are resolved by the API; RustFS is not exposed publicly.
S3_PUBLIC_BASE_URL=

# --- PDF import (AI field classification, optional) ---
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
PDF_IMPORT_FIELD_CONFIDENCE=0.75
TYPESAFE_INPUT_USD_PER_MILLION=
TYPESAFE_OUTPUT_USD_PER_MILLION=
PDF_IMPORT_MAX_PAGES=20
PDF_IMPORT_RENDER_SCALE=2
PDF_IMPORT_MAX_FILE_MB=10

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft OAuth (optional) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- GitHub OAuth (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email — password reset / verification (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@tamidoc.com
